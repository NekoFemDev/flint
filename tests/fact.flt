include "stdlib.flt"

code:
main:
    set r0, 6
    call fact
    call s_num                // r1 = 720 -> sys 0 span print
    set r0, 10
    sys 1
    exit

fact:
    push r0
    jump.ge r0, 2, rec
    pop r0
    set r1, 1
    return
rec:
    dec r0
    call fact                 // r1 = (n-1)!
    inc r0
    mul r1, r1, r0
    pop r0
    return
