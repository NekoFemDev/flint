include "stdlib.flt"

code:
main:
    // sum 1..10 = 55
    set r0, 0                // acc
    set r1, 1                // i
loop:
    jump.ge r1, 11, done
    add r0, r0, r1
    inc r1
    jump loop
done:
    copy r1, r0              // s_num argument
    call s_num               // prints "55" via sys 0 (span print)
    set r0, 10               // '\n'
    sys 1
    exit
