// math — integer helpers, written in FLINT (wrapping int64 arithmetic).
//
// Usage:   include "math.flt"
// ABI:     args r1..r3, result r0; r4..r7 may be clobbered.
//
// s_abs(r1)               r0 = |r1| (INT64_MIN stays INT64_MIN)
// s_min(r1, r2)           r0 = signed minimum
// s_max(r1, r2)           r0 = signed maximum
// s_clamp(r1, r2, r3)     r0 = r1 clamped into [r2, r3] (assumes lo <= hi)
// s_gcd(r1, r2)           r0 = non-negative gcd; gcd(0, 0) = 0
// s_lcm(r1, r2)           r0 = non-negative lcm; 0 when either is 0
//                         (wraps on overflow)
// s_isqrt(r1)             r0 = floor(sqrt(r1)); 0 when r1 < 0
// s_pow(r1, r2)           r0 = r1^r2 by squaring (wraps on overflow);
//                         negative exponent -> 0; s_pow(0, 0) = 1
// s_lcg(r1)               r0 = next state of a 64-bit LCG — feed the
//                         state back in, derive values with div/mod
// s_hash64(r1)            r0 = splitmix64 finalizer: stateless,
//                         deterministic 64-bit hash (not cryptographic)

// lib/ includes must own their section state: start with code:

code:

s_abs:
    copy r0, r1
    jump.ge r1, 0, .abs_out
    neg r0, r1
.abs_out:
    return

s_min:
    copy r0, r2
    jump.ge r1, r2, .min_out
    copy r0, r1
.min_out:
    return

s_max:
    copy r0, r1
    jump.ge r1, r2, .max_out
    copy r0, r2
.max_out:
    return

s_clamp:
    copy r0, r1
    jump.lt r1, r2, .mcl_lo
    jump.ge r1, r3, .mcl_hi
    return
.mcl_lo:
    copy r0, r2
    return
.mcl_hi:
    copy r0, r3
    return

s_gcd:                          // Euclid on magnitudes
    copy r4, r1
    jump.ge r4, 0, .gcd_b
    neg r4, r4
.gcd_b:
    copy r5, r2
    jump.ge r5, 0, .gcd_loop
    neg r5, r5
.gcd_loop:
    jump.eq r5, .gcd_out
    mod r6, r4, r5
    copy r4, r5
    copy r5, r6
    jump .gcd_loop
.gcd_out:
    copy r0, r4
    return

s_lcm:                          // lcm = a/gcd * b, sign-normalised
    call s_gcd
    jump.eq r0, .lcm_zero
    copy r4, r0
    div r5, r1, r4
    mul r5, r5, r2
    jump.ge r5, 0, .lcm_out
    neg r5, r5
.lcm_out:
    copy r0, r5
    return
.lcm_zero:
    set r0, 0
    return

s_isqrt:                        // bit-by-bit integer square root
    jump.lt r1, 0, .isq_neg
    copy r4, r1                 // n (shrinks)
    set r0, 0                   // result
    set r5, 1
    shl r5, r5, 62              // bit = highest power of 4 so far
.isq_align:
    jump.lt r4, r5, .isq_shift  // n < bit: keep descending
    jump .isq_main
.isq_shift:
    shr r5, r5, 2
    jump .isq_align
.isq_main:
    jump.eq r5, .isq_done
    copy r6, r0
    add r6, r6, r5              // try = res + bit
    jump.lt r4, r6, .isq_no     // n < try: do not take the bit
    sub r4, r4, r6
    shr r0, r0, 1
    add r0, r0, r5
    jump .isq_step
.isq_no:
    shr r0, r0, 1
.isq_step:
    shr r5, r5, 2
    jump .isq_main
.isq_done:
    return
.isq_neg:
    set r0, 0
    return

s_pow:                          // exponentiation by squaring
    jump.lt r2, 0, .pow_zero
    set r0, 1
    copy r4, r1
    copy r5, r2
.pow_loop:
    jump.eq r5, .pow_out
    copy r6, r5
    and r6, r6, 1
    jump.eq r6, .pow_sq
    mul r0, r0, r4
.pow_sq:
    mul r4, r4, r4
    shr r5, r5, 1
    jump .pow_loop
.pow_out:
    return
.pow_zero:
    set r0, 0
    return

s_lcg:                          // state' = state * mul + inc (mod 2^64)
    set r4, s_lcg_mul
    load r4, [r4+0]
    mul r0, r1, r4
    set r4, s_lcg_inc
    load r4, [r4+0]
    add r0, r0, r4
    return

s_hash64:                       // splitmix64 finalizer
    copy r0, r1
    shr r4, r0, 30
    xor r0, r0, r4
    set r4, s_hash_m1
    load r4, [r4+0]
    mul r0, r0, r4
    shr r4, r0, 27
    xor r0, r0, r4
    set r4, s_hash_m2
    load r4, [r4+0]
    mul r0, r0, r4
    shr r4, r0, 31
    xor r0, r0, r4
    return

data:
s_lcg_mul: int 6364136223846793005
s_lcg_inc: int 1442695040888963407
s_hash_m1: int 0xBF58476D1CE4E5B9
s_hash_m2: int 0x94D049BB133111EB
